<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>🎲 DiceGame | Details Game</title>
    <link href="../public/styles.css" rel="stylesheet" />
    <link href="../public/layout.css" rel="stylesheet" />
    <link href="../public/dice.css" rel="stylesheet" />
  </head>
  <body class="bg-gradient-to-b from-cyan-400 to-cyan-50 full-page">
    <%- include('components/header'); %> <% if (!error) { %>
    <div
      class="mx-auto w-4/5 flex-row justify-center items-center py-12 px-4 sm:px-6 lg:px-8"
    >
      <div class="">
        <div
          class="px-5 py-3 border-b-2 rounded-t-md border-gray-200 bg-yellow-400 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider"
        >
          Game ID : <%=game._id %>
        </div>
      </div>
      <table
        class="flex-row min-w-full leading-normal justify-center items-center"
      >
        <thead>
          <tr>
            <th
              class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider"
            >
              Id Players
            </th>
            <th
              class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider"
            >
              Name
            </th>
            <th
              class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider"
            >
              Age
            </th>
            <th
              class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider"
            >
              Score
            </th>
          </tr>
        </thead>
        <tbody>
          <% if (game.gamers.length > 0) { %> <% game.gamers.forEach(element =>
          { %>
          <tr>
            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
              <div class="flex items-center">
                <div class="ml-3">
                  <p class="text-gray-900 whitespace-no-wrap">
                    <%= element._id %>
                  </p>
                </div>
              </div>
            </td>
            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
              <p class="text-gray-900 whitespace-no-wrap">
                <%= element.name %>
              </p>
            </td>
            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
              <p class="text-gray-900 whitespace-no-wrap"><%= element.age %></p>
            </td>
            <% if (element.score != 0) { %>
            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
              <p class="text-gray-900 whitespace-no-wrap">
                <%= element.score %>
              </p>
            </td>
            <% }else{ %>
            <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
              <p class="text-gray-900 whitespace-no-wrap">-</p>
            </td>
            <% } %>
          </tr>
          <% }) %> <% } %>
        </tbody>
      </table>
      <div
        class="relative flex justify-center px-3 py-1 font-semibold leading-tight"
      >
        <% if (game.inProgress) { %>
        <span
          aria-hidden
          class="absolute inset-0 bg-green-300 opacity-50 rounded-b-lg"
        ></span>
        <span class="relative text-green-800"
          >In Progress: <%= game.inProgress %>
        </span>
        <% }else{ %>
        <span
          aria-hidden
          class="absolute inset-0 bg-gray-200 opacity-50 rounded-b-lg"
        ></span>
        <span class="relative text-gray-800"
          >In Progress: <%= game.inProgress %>
        </span>
        <% } %>
      </div>

      <%- include('components/diceStage', { game }); %>

      <div
        class="px-4 py-3 text-right sm:px-6 flex justify-between w-2/5 mx-auto my-10"
      >
        <% if (!game.inProgress) { %>
        <a
          href="/winnerGame/<%=game._id%>"
          class="group relative w-2/5 flex justify-center py-3 border border-transparent font-medium rounded-md text-white bg-cyan-400 active:bg-cyan-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-white"
        >
          View Winner
        </a>
        <% } %>
        <button
          id="btnDeleteGame"
          data-id="<%=game._id %>"
          class="group relative w-2/5 flex justify-center py-3 border border-transparent font-medium rounded-md text-white bg-red-400 active:bg-red-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-white"
        >
          Delete Game
        </button>
      </div>
    </div>
    <% }else { %>
    <div
      class="h-4/5 mx-auto w-4/5 flex-row justify-center items-center py-12 px-4 sm:px-6 lg:px-8"
    >
      <div class="bg-white p-10 rounded-lg text-gray-600 flex justify-center w-2/5 m-auto">
        <p><%= content %></p>
      </div>
      <div class="flex justify-center">
        <a
          href="/"
          class="group relative w-1/5 flex justify-center py-3 mt-8 border border-transparent font-medium rounded-md text-white bg-cyan-400 active:bg-cyan-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-white"
        >
          Go HomePage
        </a>
      </div>
    </div>

    <% } %> <%- include('components/footer'); %>
    <script>

    
      const btnDeleteGame = document.querySelector("#btnDeleteGame");
      btnDeleteGame?.addEventListener("click", async () => {
        console.log("Go to Delete");
        const id = btnDeleteGame.dataset.id;
        console.log("id: ", id);
        try {
          const data = await fetch(`/deleteGame/${id}`);
          const res = await data.json();
          if (res.estado) {
            //res.render("confirmation")
            alert("The game was delete!!");
            window.location.href = "/games";
          } else {
            console.log(res);
          }
        } catch (e) {
          console.log(e);
        }
      });

      /**
       * Turn-based play: the server rolls all the dice in one request,
       * then each player reveals their own die in turn
       */
      const stage = document.querySelector("#diceStage");
      const btnTurn = document.querySelector("#btnTurn");
      if (stage && btnTurn) {
        const id = stage.dataset.id;
        const players = [...stage.querySelectorAll(".dice-player")];
        const turnLabel = document.querySelector("#diceTurn");
        const errorLabel = document.querySelector("#diceError");
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let turn = 0;
        let result = null;
        let waitingNext = false;

        const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

        const showTurn = () => {
          players.forEach((p, i) => p.classList.toggle("is-active", i === turn));
          turnLabel.textContent = `Player ${turn + 1} of ${players.length} · ${players[turn].dataset.name}'s turn`;
          btnTurn.textContent = "Roll dice";
        };

        // Stop the spin at the end of a full turn so the landing starts smoothly
        const stopRolling = (cube) =>
          new Promise((resolve) => {
            if (reduceMotion) return resolve();
            const done = () => resolve();
            cube.addEventListener("animationiteration", done, { once: true });
            setTimeout(done, 700);
          }).then(() => cube.classList.remove("is-rolling"));

        const rollTurn = async () => {
          const player = players[turn];
          const cube = player.querySelector(".dice-cube");
          btnTurn.disabled = true;
          errorLabel.hidden = true;
          if (!reduceMotion) cube.classList.add("is-rolling");
          try {
            if (!result) {
              const [data] = await Promise.all([
                fetch(`/startGame/${id}`, { method: "PUT" }),
                wait(900),
              ]);
              const res = await data.json();
              if (!res.status) throw new Error(res.message);
              result = res;
            } else {
              await wait(900);
            }
          } catch (e) {
            console.log(e);
            cube.classList.remove("is-rolling");
            errorLabel.hidden = false;
            btnTurn.disabled = false;
            return;
          }

          const score = result.scores[turn];
          await stopRolling(cube);
          requestAnimationFrame(() => cube.classList.add(`show-${score}`));
          await wait(reduceMotion ? 0 : 1400);

          player.classList.remove("is-active");
          player.classList.add("is-done");
          player.querySelector(".dice-score").textContent = score;
          turnLabel.textContent = `${player.dataset.name} rolled ${score}`;
          btnTurn.disabled = false;

          if (turn < players.length - 1) {
            waitingNext = true;
            btnTurn.textContent = `Next player: ${players[turn + 1].dataset.name} →`;
          } else {
            const winner = players[result.winnerIndex];
            winner.classList.add("is-winner");
            turnLabel.textContent = `🏆 ${winner.dataset.name} wins with ${result.scores[result.winnerIndex]}!`;
            btnTurn.textContent = "View results";
            btnTurn.onclick = () => (window.location.href = `/findGame/${id}`);
          }
        };

        btnTurn.addEventListener("click", () => {
          if (btnTurn.onclick) return;
          if (waitingNext) {
            waitingNext = false;
            turn++;
            showTurn();
          } else {
            rollTurn();
          }
        });

        showTurn();
      }
    </script>
  </body>
</html>
