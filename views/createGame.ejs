<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>🎲 DiceGame | Create Game</title>
    <link href="../public/styles.css" rel="stylesheet" />
    <link href="../public/layout.css" rel="stylesheet" />
  </head>
  <body class="bg-gradient-to-b from-cyan-400 to-cyan-50 full-page">
    <%- include('components/header'); %>
    <div class="pb-12">
      <div class="flex items-center justify-center px-4 sm:px-6 lg:px-8">
        <div class="max-w-md w-full space-y-8">
          <div>
            <img
              class="mx-auto h-12 w-auto"
              src="https://res.cloudinary.com/adev48/image/upload/v1652573714/Sofka%20Assets/Semana%204/dices_tzeuva.png"
              alt="Dices"
            />
            <h1 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
              Create Game
            </h1>
          </div>
          <form class="mt-8 space-y-6" action="createGame" method="POST">
            <div class="rounded-md shadow-sm">
              <label
                for="players"
                class="block mb-2 text-center text-xl font-bold text-gray-800"
              >
                Number of players
              </label>
              <select
                id="players"
                name="players"
                class="w-full h-12 rounded-lg px-4 border border-gray-300 text-gray-800 bg-white focus:outline-none"
              >
                <% for (let n = minPlayers; n <= maxPlayers; n++) { %>
                <option value="<%= n %>" <%= n === defaultPlayers ? "selected" : "" %>><%= n %> players</option>
                <% } %>
              </select>
            </div>

            <% for (let i = 1; i <= maxPlayers; i++) { const off = i > defaultPlayers; %>
            <div class="rounded-md shadow-sm -space-y-px player-fields" <%= off ? "hidden" : "" %>>
              <h3 class="mt-6 mb-2 text-center text-xl font-bold text-gray-800">
                Player <%= i %>
              </h3>
              <div>
                <label for="nameP<%= i %>" class="sr-only">Name</label>
                <input
                  id="nameP<%= i %>"
                  name="nameP<%= i %>"
                  type="text"
                  autocomplete="given-name"
                  required
                  <%= off ? "disabled" : "" %>
                  class="w-full h-12 rounded-t-lg p-4 border-t mr-0 border-b border-l text-gray-800 border-gray-300 bg-white focus:outline-none focus:ring-gray-50 focus:border-gray-50 focus:z-10"
                  placeholder="Name or Nickname"
                />
              </div>
              <div>
                <label for="ageP<%= i %>" class="sr-only">Age</label>
                <input
                  id="ageP<%= i %>"
                  name="ageP<%= i %>"
                  type="number"
                  min="1"
                  max="120"
                  required
                  <%= off ? "disabled" : "" %>
                  class="w-full h-12 rounded-b-lg p-4 border-t mr-0 border-b border-l text-gray-800 border-gray-300 bg-white focus:outline-none focus:ring-gray-50 focus:border-gray-50 focus:z-10"
                  placeholder="Age"
                />
              </div>
            </div>
            <% } %>

            <div class="flex justify-center">
              <button
                type="submit"
                class="group relative w-3/5 flex justify-center py-4 border border-transparent  font-medium rounded-md text-white bg-cyan-400 active:bg-cyan-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-white"
              >
                <span class="absolute left-0 inset-y-0 flex items-center pl-3">
                </span>
                Create Game
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
    <%- include('components/footer'); %>
    <script>
      /**
       * Show only the fields for the selected number of players;
       * disabled inputs are skipped by validation and not submitted
       */
      const playersSelect = document.querySelector("#players");
      const playerFields = document.querySelectorAll(".player-fields");
      const showPlayers = () => {
        const count = Number(playersSelect.value);
        playerFields.forEach((fields, i) => {
          const active = i < count;
          fields.hidden = !active;
          fields.querySelectorAll("input").forEach((input) => (input.disabled = !active));
        });
      };
      playersSelect.addEventListener("change", showPlayers);
      showPlayers();
    </script>
  </body>
</html>
