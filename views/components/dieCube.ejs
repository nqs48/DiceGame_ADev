<%
  /**
   * 3D die. Optional `value` (1-6) renders it already showing that face.
   * Pips position in a 3x3 grid for each dice value
   */
  const pips = { 1: [5], 2: [1, 9], 3: [1, 5, 9], 4: [1, 3, 7, 9], 5: [1, 3, 5, 7, 9], 6: [1, 3, 4, 6, 7, 9] };
  const shown = typeof value !== "undefined" && value ? " show-" + value : "";
%>
<div class="dice-scene">
  <div class="dice-cube<%= shown %>">
    <% for (let face = 1; face <= 6; face++) { %>
    <div class="dice-face face-<%= face %>">
      <% for (let cell = 1; cell <= 9; cell++) { %>
      <span class="<%= pips[face].includes(cell) ? 'pip' : '' %>"></span>
      <% } %>
    </div>
    <% } %>
  </div>
</div>
